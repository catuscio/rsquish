{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rsquish",
  "version": "0.1.0",
  "identifier": "app.rsquish.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rsquish",
        "width": 1120,
        "height": 800,
        "minWidth": 840,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Photography",
    "shortDescription": "Local photo optimization",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
